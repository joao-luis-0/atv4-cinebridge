{
  "name": "cinebridge-recomendacao",
  "version": "0.4.0",
  "description": "Microsserviço de recomendação e orquestração de equipes - plataforma cinebridge",
  "main": "dist/distributed/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/distributed/main.js",
    "dev": "ts-node-dev --respawn --transpile-only src/distributed/main.ts",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typeorm": "typeorm-ts-node-commonjs",
    "benchmark": "npm run build && node scripts/benchmark.js",
    "start:distributed": "node dist/distributed/main.js",
    "test:e2e": "node scripts/smoke-atv4.js",
    "start:legacy": "node dist/interfaces/http/server.js",
    "dev:legacy": "ts-node-dev --respawn --transpile-only src/interfaces/http/server.ts"
  },
  "keywords": [
    "cinebridge",
    "recomendacao",
    "microsservico"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "amqplib": "^0.10.9",
    "fastify": "^4.28.1",
    "nodemailer": "^7.0.13",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.10",
    "@types/nodemailer": "^7.0.12",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^7.16.1",
    "@typescript-eslint/parser": "^7.16.1",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "toad-cache": "3.3.0"
  }
}
